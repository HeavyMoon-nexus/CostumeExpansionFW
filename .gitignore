# Internal dev docs are LOCAL-ONLY from 2026-08-04 (owner decision).
# ONE rule, ONE place: every development document -- investigation notes, test
# lists, plans, audits, archived designs, Nexus/PM drafts -- lives under
# cef_documents/ and never enters the repo. Put new dev docs THERE, not at the
# repo root; nothing else needs a .gitignore entry.
# Deliberately still tracked (public-facing, do not move into cef_documents/):
#   README.md + fsmp_patches/ + tools/nifcarrier/ READMEs, CHANGELOG.md
#   (release process), THIRD-PARTY-NOTICES.md (license notices),
#   NPC_SUPPORT_TESTING_EN.md (linked from the public v1.4.0-beta.1 release),
#   README_NPC.txt / README_VR.txt (shipped inside the release archives).
cef_documents/

# Safety net: an outbound PM draft must never reach the public repo, even if
# one gets written outside cef_documents/replies/ by mistake.
PM_DRAFT_*.md

# ETW traces (memory investigation)
*.etl
NEXUS_CHANGELOG_v*.txt

# Release staging output
dist/
NIFCARRIER_INPROC.md
tools/nifcarrier/sync_carriers.local.cmd

# Nexus store-page description draft (local working copy)
2GAME_DESCRIPTION_ja.txt

# Python bytecode from the dev tools in tools/
__pycache__/
*.pyc
